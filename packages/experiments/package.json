{
  "name": "specpi-experiments",
  "version": "0.1.0",
  "description": "Bounded detached Git worktree experiments for Pi: try an idea in an isolated worktree, export it as a patch, or discard it",
  "author": "Tanner Middleton",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TannerMidd/SpecPi.git",
    "directory": "packages/experiments"
  },
  "keywords": ["pi-package", "pi-coding-agent", "git", "worktree", "experiments"],
  "files": ["src", "README.md", "SECURITY.md", "THIRD_PARTY.md", "LICENSE"],
  "pi": { "extensions": ["./src/index.ts"] },
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "22.20.1",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "check:types": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run check:types && npm test && npm run check:package"
  }
}
