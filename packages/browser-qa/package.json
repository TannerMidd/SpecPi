{
  "name": "specpi-browser-qa",
  "version": "0.3.0",
  "description": "Node-native browser QA tools for Pi: interactions, accessibility and visual regression",
  "author": "Tanner Middleton",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TannerMidd/SpecPi.git",
    "directory": "packages/browser-qa"
  },
  "keywords": ["pi-package", "playwright", "accessibility", "visual-regression"],
  "bin": { "specpi-browser-qa": "./bin/browser-qa.mjs" },
  "files": ["bin", "src", "README.md", "SECURITY.md", "THIRD_PARTY.md", "LICENSE"],
  "pi": { "extensions": ["./src/index.ts"] },
  "engines": { "node": ">=22.19.0" },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "axe-core": "4.13.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "22.20.1",
    "typebox": "1.3.7",
    "typescript": "6.0.3"
  },
  "scripts": {
    "setup": "node bin/browser-qa.mjs setup",
    "doctor": "node bin/browser-qa.mjs doctor",
    "check:types": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser.integration.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run check:types && npm test && npm run test:browser && npm run check:package"
  }
}
