# Eval provider credentials: ONE key powers every harness.
# Copy to evals/.env (git-ignored, never commit keys) and fill in the key:
#   cp evals/.env.example evals/.env
#
# OpenCode itself needs nothing here; it reads its own auth. The Pi family
# reaches the same OpenCode Go subscription through the logging proxy,
# which forwards to the endpoint below with this key (Bearer, process-local
# only, never written to logs or reports).

# OpenCode Go OpenAI-compatible base (fixed, from the installed provider definition):
EVAL_FORWARD_URL=https://opencode.ai/zen/go/v1/chat/completions

# Optional: the provider's Responses API endpoint, used only by harnesses that
# speak it (--harness=codex). Omit it and the runner swaps
# /chat/completions for /responses in EVAL_FORWARD_URL above.
EVAL_FORWARD_RESPONSES_URL=

# Your OpenCode Go API key (the same subscription OpenCode uses):
EVAL_FORWARD_KEY=

# Provider-side model id (the frozen list keeps the short logical id):
EVAL_FORWARD_MODEL=deepseek-v4.1-flash

# Optional: the DeepSeek Harness bin, needed only for --harness=dsh. It is a
# path, not a credential, and the runner reports the harness unavailable
# rather than failing the run when it is absent. Typical npm global install:
#   SPECPI_DSH_CLI=C:/Users/<you>/AppData/Roaming/npm/node_modules/@deepseek-ai/dsh/lib/bin.js
SPECPI_DSH_CLI=

# Optional: the Codex CLI binary, needed only for --harness=codex. Also a
# path, not a credential; absent means the harness reports itself unavailable.
# Leave empty to discover the installed `codex` on PATH.
SPECPI_CODEX_CLI=

# ---------------------------------------------------------------------------
# Jev (TypeSafe System One, reached through OpenRouter). Used by
# scripts/jev-calibrate.mjs, scripts/jev-triage.mjs and --harness=specpi-jev.
# ---------------------------------------------------------------------------

# ONE key powers the whole Jev layer. Jev is published on OpenRouter, and both
# specpi-jev-guard and the advisor reach it there, so this is an OpenRouter key
# (sk-or-...) from https://openrouter.ai/keys. A TypeSafe key is NOT
# interchangeable: the other service rejects it with a bare 401.
# Verify with: node scripts/jev-calibrate.mjs --probe
OPENROUTER_API_KEY=

# Optional. Set JEV_BACKEND=typesafe to use the direct api.typesafe.ai API
# instead, which needs a TypeSafe key in TYPESAFE_API_KEY rather than the above.
# JEV_BACKEND=

# Optional. Redirects the Jev endpoint. Tests use it so they never reach the
# network, and --harness=specpi-jev points it at the eval proxy so the advisor's
# own spend is priced instead of invisible to the cost report.
TYPESAFE_BASE_URL=
