{
    "id": "t4-research-dossier",
    "tier": 4,
    "category": "terminal",
    "title": "Answer a 45-question bank from a 1,675-document knowledge base",
    "timeoutMs": 2700000,
    "turnCap": 900,
    "writable": [
        "answers.json",
        "notes",
