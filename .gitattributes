specpi text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.mts text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
# Generated by scripts/context-chart.mjs, which writes LF. Without this the working tree gets
# CRLF on Windows checkouts and every chart check reports drift it cannot resolve.
*.svg text eol=lf
# Eval fixtures are compared byte for byte by their checkers and several are
# hashed, so a CRLF checkout on Windows fails tasks that are actually correct.
# CI caught this as a reference solution "failing" t1-no-touch, whose whole
# point is that one file must come back unchanged.
evals/** text eol=lf
*.cmd text eol=crlf
