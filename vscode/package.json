{
    "name": "specpi-chat",
    "displayName": "SpecPi Chat",
    "description": "A native VS Code chat sidebar for your local Pi agent and SpecPi harness.",
    "version": "0.4.1",
    "publisher": "tannermidd",
    "private": true,
    "preview": true,
    "icon": "media/marketplace-icon.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/TannerMidd/SpecPi.git",
        "directory": "vscode"
    },
    "bugs": {
        "url": "https://github.com/TannerMidd/SpecPi/issues"
    },
    "engines": {
        "vscode": "^1.96.0",
        "node": ">=22.19.0"
    },
    "categories": [
        "Machine Learning",
        "Other"
    ],
    "keywords": [
        "specpi",
        "pi",
        "chat",
        "coding-agent"
    ],
    "type": "commonjs",
    "main": "./src/extension.js",
    "extensionKind": [
        "workspace"
    ],
    "activationEvents": [
        "onView:specpi.chat"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false,
            "description": "SpecPi Chat starts a local coding agent with workspace access. Trust the folder to connect."
        },
        "virtualWorkspaces": {
            "supported": false,
            "description": "SpecPi Chat requires a filesystem workspace and a local Pi process."
        }
    },
    "scripts": {
        "check": "node scripts/check.mjs",
        "package": "node scripts/package.mjs",
        "test": "node --test ../tests/vscode-*.test.mjs",
        "test:host": "node scripts/test-host.mjs",
        "test:vsix": "node scripts/test-host.mjs --vsix",
        "test:render": "node scripts/test-render.mjs",
        "dev": "node scripts/dev-host.mjs"
    },
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "specpi-chat",
                    "title": "SpecPi Chat",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "specpi-chat": [
                {
                    "id": "specpi.chat",
                    "name": "Chat",
                    "type": "webview",
                    "contextualTitle": "SpecPi Chat"
                }
            ]
        },
        "commands": [
            {
                "command": "specpi.chat.open",
                "title": "Open Chat",
                "category": "SpecPi",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "specpi.chat.new",
                "title": "New Chat",
                "category": "SpecPi",
                "icon": "$(add)"
            },
            {
                "command": "specpi.chat.history",
                "title": "Chat History",
                "category": "SpecPi",
                "icon": "$(history)"
            },
            {
                "command": "specpi.chat.stop",
                "title": "Stop Response",
                "category": "SpecPi",
                "icon": "$(debug-stop)"
            },
            {
                "command": "specpi.chat.attachSelection",
                "title": "Attach Selection to Chat",
                "category": "SpecPi",
                "icon": "$(code)"
            },
            {
                "command": "specpi.chat.attachFile",
                "title": "Attach File to Chat",
                "category": "SpecPi",
                "icon": "$(attach)"
            },
            {
                "command": "specpi.chat.attachImage",
                "title": "Attach Images to Chat",
                "category": "SpecPi",
                "icon": "$(file-media)"
            },
            {
                "command": "specpi.chat.editPrompt",
                "title": "Edit Earlier Prompt in New Branch",
                "category": "SpecPi"
            },
            {
                "command": "specpi.chat.forkChat",
                "title": "Branch Conversation",
                "category": "SpecPi"
            },
            {
                "command": "specpi.chat.exportChat",
                "title": "Export Conversation",
                "category": "SpecPi"
            },
            {
                "command": "specpi.chat.showUsage",
                "title": "Chat Usage Details",
                "category": "SpecPi"
            },
            {
                "command": "specpi.chat.settings",
                "title": "Chat Settings",
                "category": "SpecPi",
                "icon": "$(settings-gear)"
            },
            {
                "command": "specpi.chat.connect",
                "title": "Connect Pi",
                "category": "SpecPi",
                "icon": "$(plug)"
            },
            {
                "command": "specpi.chat.restart",
                "title": "Restart Pi",
                "category": "SpecPi",
                "icon": "$(refresh)"
            },
            {
                "command": "specpi.chat.disconnect",
                "title": "Disconnect Pi",
                "category": "SpecPi",
                "icon": "$(debug-disconnect)"
            },
            {
                "command": "specpi.chat.chooseWorkspace",
                "title": "Choose Chat Workspace",
                "category": "SpecPi",
                "icon": "$(folder-opened)"
            }
        ],
        "keybindings": [
            {
                "command": "specpi.chat.open",
                "key": "ctrl+alt+s",
                "mac": "cmd+alt+s"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "specpi.chat.attachSelection",
                    "when": "isWorkspaceTrusted && editorHasSelection && resourceScheme == file",
                    "group": "specpi@1"
                },
                {
                    "command": "specpi.chat.attachFile",
                    "when": "isWorkspaceTrusted && resourceScheme == file",
                    "group": "specpi@2"
                }
            ],
            "explorer/context": [
                {
                    "command": "specpi.chat.attachFile",
                    "when": "isWorkspaceTrusted && resourceScheme == file && !explorerResourceIsFolder",
                    "group": "specpi@1"
                }
            ],
            "view/title": [
                {
                    "command": "specpi.chat.new",
                    "when": "view == specpi.chat",
                    "group": "navigation@1"
                },
                {
                    "command": "specpi.chat.history",
                    "when": "view == specpi.chat",
                    "group": "navigation@2"
                },
                {
                    "command": "specpi.chat.restart",
                    "when": "view == specpi.chat",
                    "group": "navigation@3"
                },
                {
                    "command": "specpi.chat.settings",
                    "when": "view == specpi.chat",
                    "group": "navigation@4"
                }
            ]
        },
        "configuration": {
            "title": "SpecPi Chat",
            "properties": {
                "specpi.chat.piPath": {
                    "type": "string",
                    "default": "",
                    "scope": "application",
                    "markdownDescription": "Absolute path to the Pi executable or JavaScript CLI entry point. Leave empty to discover Pi on PATH. A path only; shell commands and additional arguments are not accepted. Configure Pi and SpecPi separately before connecting."
                },
                "specpi.chat.nodePath": {
                    "type": "string",
                    "default": "",
                    "scope": "application",
                    "markdownDescription": "Absolute path to Node.js when running a JavaScript Pi CLI. Leave empty to discover Node.js on PATH. A path only; additional arguments are not accepted."
                }
            }
        }
    }
}
