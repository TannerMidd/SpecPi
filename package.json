{
  "name": "specpi",
  "version": "0.26.0",
  "description": "Scope control and a human-selected harness improvement loop for Pi",
  "author": "Tanner Middleton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TannerMidd/SpecPi.git"
  },
  "bugs": {
    "url": "https://github.com/TannerMidd/SpecPi/issues"
  },
  "homepage": "https://tannermidd.github.io/SpecPi/",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "agent-harness"
  ],
  "bin": {
    "specpi": "./scripts/specpi.mjs"
  },
  "files": [
    "specpi",
    "specpi.cmd",
    "scripts/specpi.mjs",
    "scripts/lib.mjs",
    "scripts/lock.mjs",
    "scripts/packages.mjs",
    "templates",
    "extensions",
    "skills",
    "README.md",
    "SECURITY.md",
    "SECURITY_MODEL.md",
    "THIRD_PARTY.md",
    "CHANGELOG.md",
    "LICENSE",
    "NPM_RELEASE.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "format": "prettier --config prettier.config.mjs --write \"**/*.{js,mjs,ts,mts,tsx}\" && eslint --config eslint.config.js . --fix --rule \"@stylistic/max-statements-per-line: off\" && prettier --config prettier.config.mjs --write \"**/*.{js,mjs,ts,mts,tsx}\" && eslint --config eslint.config.js . --fix",
    "format:check": "prettier --config prettier.config.mjs --check \"**/*.{js,mjs,ts,mts,tsx}\" && eslint --config eslint.config.js .",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:pi-package": "node scripts/check-pi-package.mjs",
    "check:base": "node scripts/check-base-packages.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:browser-qa": "npm --prefix packages/browser-qa run check",
    "check:delegation": "npm --prefix packages/delegation run check",
    "check:experiments": "npm --prefix packages/experiments run check",
    "check:vscode": "npm --prefix vscode run check",
    "prepublishOnly": "npm run check",
    "check": "npm run format:check && npm run check:syntax && npm test && npm run check:package && npm run check:vscode"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "typebox": "1.3.7",
    "playwright": "1.62.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
