{
  "name": "specpi",
  "version": "0.12.0",
  "description": "An explicit, privacy-conscious, self-improving harness for the Pi coding agent",
  "author": "Tanner Middleton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TannerMidd/SpecPi.git"
  },
  "bugs": {
    "url": "https://github.com/TannerMidd/SpecPi/issues"
  },
  "homepage": "https://github.com/TannerMidd/SpecPi#readme",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "agent-harness"
  ],
  "bin": {
    "specpi": "./scripts/specpi.mjs"
  },
  "files": [
    "specpi",
    "specpi.cmd",
    "scripts",
    "browser-runtime",
    "templates",
    "extensions",
    "skills",
    "themes",
    "shell",
    "README.md",
    "docs/delegation",
    "site/logo.svg",
    "site/self-improvement-loop-v2.svg",
    "SECURITY.md",
    "SECURITY_MODEL.md",
    "THIRD_PARTY.md",
    "CHANGELOG.md",
    "LICENSE",
    "NPM_RELEASE.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "format": "prettier --config prettier.config.mjs --write \"**/*.{js,mjs,ts,tsx}\" && eslint --config eslint.config.js . --fix --rule \"@stylistic/max-statements-per-line: off\" && prettier --config prettier.config.mjs --write \"**/*.{js,mjs,ts,tsx}\" && eslint --config eslint.config.js . --fix",
    "format:check": "prettier --config prettier.config.mjs --check \"**/*.{js,mjs,ts,tsx}\" && eslint --config eslint.config.js .",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:pi-package": "node scripts/check-pi-package.mjs",
    "prepublishOnly": "npm run check",
    "check": "npm run format:check && npm run check:syntax && npm test && npm run check:package"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
